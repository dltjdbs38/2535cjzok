# staging 전용 환경변수. `cp env.staging.example .env.staging` 후 값을 채운다. (.env.staging은 git에 올리지 말 것)
# prod .env와 SECRET_KEY가 달라야 한다 (staging 세션이 prod에서 통하면 안 됨).
DJANGO_SECRET_KEY=prod와-다른-긴-랜덤-문자열
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.your-domain.com

# staging은 카카오 로그인을 안 쓰므로 비워둬도 된다 (부하테스트 전용 로그인 통로를 쓴다).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---- 부하테스트 전용 로그인 통로 ----
# prod에는 절대 넣지 말 것. 토큰은 24자 이상(짧으면 통로가 아예 안 열림):
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"
LOADTEST_ENABLED=True
LOADTEST_TOKEN=여기에-생성한-토큰

# ---- DB: 기본은 prod와 같은 SQLite (디렉터리를 마운트했으니 /app/staging-data 아래) ----
DATABASE_URL=sqlite:////app/staging-data/db.sqlite3
# Postgres 비교실험(5단계)에서는 위 줄 대신 아래를 쓴다:
# DATABASE_URL=postgres://loadtest:loadtest@db:5432/loadtest

# ---- gunicorn 튜닝 (비교실험할 때 이 값만 바꿔서 재기동) ----
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
