# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워 넣는다.   예) cp .env.example .env
# .env는 절대 git에 올리지 말 것 (.gitignore에 .env가 들어 있어야 함)
# 작성 규칙: "=" 앞뒤에 공백을 두지 말고, 값에 따옴표도 붙이지 않는다.

# ---- Django ----
# 길고 무작위인 문자열. 서버에서 아래 명령으로 만든 값을 넣는다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# 사람이 외우기 쉬운 문장은 쓰지 말 것 (세션/CSRF 서명에 쓰이는 값이라 추측되면 위험함)
DJANGO_SECRET_KEY=여기에-생성한-긴-랜덤-문자열

# 로컬 개발: True / 서버 배포: False  (서버에서 True로 두면 에러 화면에 내부 정보가 노출됨)
DJANGO_DEBUG=False

# 접속을 허용할 도메인. 여러 개면 쉼표로 구분. (로컬 개발은 비워도 localhost는 기본 허용)
DJANGO_ALLOWED_HOSTS=your-domain.com

# https로 접속하는 주소. 반드시 https:// 까지 포함. (로컬 개발은 비워둠)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ---- 카카오 로그인 ----
# 카카오 개발자센터 > [앱 설정] > [앱 키]에서 확인한 REST API 키
KAKAO_CLIENT_ID=여기에-REST-API-키

# 카카오 개발자센터 > [카카오 로그인] > [보안]에서 발급받은 Client Secret
KAKAO_CLIENT_SECRET=여기에-Client-Secret
